<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="015-01-create-inquiries" author="savvy">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="inquiries"/></not>
        </preConditions>
        <createTable tableName="inquiries">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(50)"/>
            <column name="email" type="VARCHAR(200)"/>
            <column name="event_title" type="VARCHAR(300)"/>
            <column name="message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="inquiries" indexName="idx_inquiries_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
