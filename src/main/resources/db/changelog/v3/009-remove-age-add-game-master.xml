<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Удаляем поля возрастных групп из events -->
    <changeSet id="009-01-drop-age-group" author="dev">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="events" columnName="age_group"/>
        </preConditions>
        <dropColumn tableName="events" columnName="age_group"/>
    </changeSet>

    <changeSet id="009-02-drop-min-age" author="dev">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="events" columnName="min_age"/>
        </preConditions>
        <dropColumn tableName="events" columnName="min_age"/>
    </changeSet>

    <changeSet id="009-03-drop-max-age" author="dev">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="events" columnName="max_age"/>
        </preConditions>
        <dropColumn tableName="events" columnName="max_age"/>
    </changeSet>

    <!-- Добавляем поле мастера игры -->
    <changeSet id="009-04-add-game-master" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="game_master"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="game_master" type="varchar(200)"/>
        </addColumn>
    </changeSet>

    <!-- Обновляем формат категории "Словесная ролевая игра" на RPG -->
    <changeSet id="009-05-update-rpg-format" author="dev">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM event_categories WHERE name = 'Словесная ролевая игра' AND format = 'RECURRING'
            </sqlCheck>
        </preConditions>
        <update tableName="event_categories">
            <column name="format" value="RPG"/>
            <where>name = 'Словесная ролевая игра'</where>
        </update>
    </changeSet>

</databaseChangeLog>
