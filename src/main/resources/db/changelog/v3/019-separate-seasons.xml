<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- 1. Create the seasons table -->
    <changeSet id="019-1" author="savvy">
        <createTable tableName="seasons">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="base_name" type="VARCHAR(255)"/>
            <column name="base_website" type="VARCHAR(512)"/>
            <column name="price" type="DECIMAL(10,2)"/>
            <column name="period" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="PUBLISHED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 2. Add season_id FK to events -->
    <changeSet id="019-2" author="savvy">
        <addColumn tableName="events">
            <column name="season_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="events"
                baseColumnNames="season_id"
                constraintName="fk_events_season"
                referencedTableName="seasons"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

    <!-- 3. Rename CAMP_OUTDOOR → SESSION_OUTDOOR and CAMP_CITY → SESSION_CITY in event_categories.format -->
    <changeSet id="019-3" author="savvy">
        <update tableName="event_categories">
            <column name="format" value="SESSION_OUTDOOR"/>
            <where>format = 'CAMP_OUTDOOR'</where>
        </update>
        <update tableName="event_categories">
            <column name="format" value="SESSION_CITY"/>
            <where>format = 'CAMP_CITY'</where>
        </update>
    </changeSet>

    <!-- 4. Drop old camp-specific columns from events -->
    <changeSet id="019-4" author="savvy">
        <dropForeignKeyConstraint baseTableName="events" constraintName="fk_events_parent"/>
        <dropColumn tableName="events" columnName="parent_id"/>
        <dropColumn tableName="events" columnName="year"/>
        <dropColumn tableName="events" columnName="base_name"/>
        <dropColumn tableName="events" columnName="base_website"/>
    </changeSet>

    <!-- 5. Restore NOT NULL on start_date (all real events must have a date now) -->
    <!-- Note: commented out to keep nullable for events migrated from old data;
         can be enabled after data cleanup -->
    <!-- <changeSet id="019-5" author="savvy">
        <addNotNullConstraint tableName="events" columnName="start_date" columnDataType="DATE"/>
    </changeSet> -->

</databaseChangeLog>
