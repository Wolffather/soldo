<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Делаем telegram_id nullable (поддержка других провайдеров) -->
    <changeSet id="010-01-telegram-id-nullable" author="dev">
        <sql>ALTER TABLE users ALTER COLUMN telegram_id DROP NOT NULL</sql>
        <rollback>
            <sql>ALTER TABLE users ALTER COLUMN telegram_id SET NOT NULL</sql>
        </rollback>
    </changeSet>

    <!-- Создаём таблицу провайдеров авторизации -->
    <changeSet id="010-02-create-user-auth-providers" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="user_auth_providers"/></not>
        </preConditions>
        <createTable tableName="user_auth_providers">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_auth_provider_user"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="provider" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="provider_user_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>

        <addUniqueConstraint
                tableName="user_auth_providers"
                columnNames="provider, provider_user_id"
                constraintName="uq_provider_user_id"/>
    </changeSet>

    <!-- Мигрируем существующих Telegram-пользователей -->
    <changeSet id="010-03-migrate-telegram-users" author="dev">
        <sql>
            INSERT INTO user_auth_providers (user_id, provider, provider_user_id, created_at)
            SELECT id, 'TELEGRAM', CAST(telegram_id AS VARCHAR), created_at
            FROM users
            WHERE telegram_id IS NOT NULL
              AND NOT EXISTS (
                SELECT 1 FROM user_auth_providers uap
                WHERE uap.user_id = users.id AND uap.provider = 'TELEGRAM'
              )
        </sql>
        <rollback>
            DELETE FROM user_auth_providers WHERE provider = 'TELEGRAM'
        </rollback>
    </changeSet>

</databaseChangeLog>
