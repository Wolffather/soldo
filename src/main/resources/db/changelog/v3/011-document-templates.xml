<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Шаблоны документов для лагерей -->
    <changeSet id="011-01-document-templates" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="document_templates"/></not>
        </preConditions>
        <createTable tableName="document_templates">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="file_url" type="varchar(500)"/>
            <column name="category_format" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_required" type="boolean" defaultValueBoolean="true"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>

        <createIndex tableName="document_templates" indexName="idx_doc_templates_format">
            <column name="category_format"/>
        </createIndex>
    </changeSet>

    <!-- Связь бронирований с документами -->
    <changeSet id="011-02-booking-documents" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="booking_documents"/></not>
        </preConditions>
        <createTable tableName="booking_documents">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="booking_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_booking_doc_booking"
                             referencedTableName="bookings"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="document_template_id" type="bigint">
                <constraints foreignKeyName="fk_booking_doc_template"
                             referencedTableName="document_templates"
                             referencedColumnNames="id"/>
            </column>
            <column name="delivered" type="boolean" defaultValueBoolean="false"/>
            <column name="delivered_at" type="timestamp"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
