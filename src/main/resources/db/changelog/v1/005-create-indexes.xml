<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- Поиск бронирований по пользователю -->
    <changeSet id="005-idx-bookings-user" author="savvy">
        <createIndex indexName="idx_bookings_user_id"
                     tableName="bookings">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- Поиск бронирований по событию -->
    <changeSet id="005-idx-bookings-event" author="savvy">
        <createIndex indexName="idx_bookings_event_id"
                     tableName="bookings">
            <column name="event_id"/>
        </createIndex>
    </changeSet>

    <!--
        Составной уникальный индекс: один пользователь — одно активное
        бронирование на событие. Partial index через SQL, т.к. Liquibase
        не поддерживает WHERE в createIndex.
    -->
    <changeSet id="005-idx-bookings-unique-active" author="savvy">
        <sql>
            CREATE UNIQUE INDEX idx_bookings_unique_active
            ON bookings (user_id, event_id)
            WHERE status != 'CANCELLED';
        </sql>
        <rollback>
            DROP INDEX IF EXISTS idx_bookings_unique_active;
        </rollback>
    </changeSet>

</databaseChangeLog>