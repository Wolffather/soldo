<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!--
        event_bookings_summary.id == event_id (через @MapsId в JPA).
        Поэтому PK = event_id, отдельного автоинкремента нет.
    -->
    <changeSet id="004-create-summary" author="savvy">
        <createTable tableName="event_bookings_summary">
            <column name="event_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="total_bookings" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="confirmed_bookings" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="num_of_participants" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="event_bookings_summary"
                baseColumnNames="event_id"
                constraintName="fk_summary_event"
                referencedTableName="events"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>