<?xml version="1.0" encoding="UTF-8"?>
<!--
    Мастер-чейнджлог Soldo.

    Все миграции v1–v6, накопившиеся за время разработки, были сконсолидированы
    в один инициализирующий скрипт init/001-init-schema.xml + functions SQL.
    Это даёт чистый деплой на новых окружениях и значительно ускоряет старт.

    Для новых изменений схемы — добавляйте файлы в соответствующую директорию,
    например init/003-*.xml, init/004-*.xml и т.д. (либо создайте v2/ для
    следующего крупного этапа).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="000-create-schema" author="savvy">
        <sql>CREATE SCHEMA IF NOT EXISTS soldo_schema;</sql>
        <rollback>DROP SCHEMA IF EXISTS soldo_schema CASCADE;</rollback>
    </changeSet>

    <include file="db/changelog/init/001-init-schema.xml"/>
    <include file="db/changelog/init/002-booking-summary-functions.sql"/>
    <include file="db/changelog/init/003-remove-multitenancy.xml"/>
    <include file="db/changelog/init/004-remove-categories.xml"/>

</databaseChangeLog>
