<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Пересоздаём FK notifications.event_id с ON DELETE CASCADE -->
    <changeSet id="008-01-notifications-event-cascade" author="dev">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyTableName="notifications"
                                        foreignKeyName="fk_notification_event"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="notifications"
                                  constraintName="fk_notification_event"/>
        <addForeignKeyConstraint baseTableName="notifications"
                                 baseColumnNames="event_id"
                                 constraintName="fk_notification_event"
                                 referencedTableName="events"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- Пересоздаём FK notifications.booking_id с ON DELETE CASCADE -->
    <changeSet id="008-02-notifications-booking-cascade" author="dev">
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyTableName="notifications"
                                        foreignKeyName="fk_notification_booking"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="notifications"
                                  constraintName="fk_notification_booking"/>
        <addForeignKeyConstraint baseTableName="notifications"
                                 baseColumnNames="booking_id"
                                 constraintName="fk_notification_booking"
                                 referencedTableName="bookings"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
