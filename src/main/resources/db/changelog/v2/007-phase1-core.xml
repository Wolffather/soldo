<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ═══ Категории событий ═══ -->
    <changeSet id="007-01-event-categories" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="event_categories"/></not>
        </preConditions>
        <createTable tableName="event_categories">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="format" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="season" type="varchar(20)"/>
            <column name="description" type="text"/>
            <column name="icon_url" type="varchar(500)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <changeSet id="007-01b-seed-categories" author="dev">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM event_categories</sqlCheck>
        </preConditions>
        <insert tableName="event_categories">
            <column name="name" value="Городской лагерь"/>
            <column name="format" value="CAMP_CITY"/>
            <column name="season" value="SUMMER"/>
        </insert>
        <insert tableName="event_categories">
            <column name="name" value="Загородный лагерь"/>
            <column name="format" value="CAMP_OUTDOOR"/>
            <column name="season" value="SUMMER"/>
        </insert>
        <insert tableName="event_categories">
            <column name="name" value="Словесная ролевая игра"/>
            <column name="format" value="RECURRING"/>
            <column name="season" value="ALL_YEAR"/>
        </insert>
        <insert tableName="event_categories">
            <column name="name" value="Сплочение коллектива"/>
            <column name="format" value="RECURRING"/>
            <column name="season" value="ALL_YEAR"/>
        </insert>
        <insert tableName="event_categories">
            <column name="name" value="Мастер-класс"/>
            <column name="format" value="ONE_TIME"/>
            <column name="season" value="ALL_YEAR"/>
        </insert>
    </changeSet>

    <!-- ═══ Обновление events — каждая колонка отдельно ═══ -->
    <changeSet id="007-02a-events-category-id" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="category_id"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="category_id" type="bigint">
                <constraints foreignKeyName="fk_event_category"
                             referencedTableName="event_categories"
                             referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="007-02b-events-min-age" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="min_age"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="min_age" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-02c-events-max-age" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="max_age"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="max_age" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-02d-events-age-group" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="age_group"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="age_group" type="varchar(30)"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-02e-events-price" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="price"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="price" type="decimal(10,2)" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-02f-events-status" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="events" columnName="status"/></not>
        </preConditions>
        <addColumn tableName="events">
            <column name="status" type="varchar(20)" defaultValue="PUBLISHED"/>
        </addColumn>
    </changeSet>

    <!-- ═══ Профили участников ═══ -->
    <changeSet id="007-03-participant-profiles" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="participant_profiles"/></not>
        </preConditions>
        <createTable tableName="participant_profiles">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_profile_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="full_name" type="varchar(200)"/>
            <column name="birth_date" type="date"/>
            <column name="school" type="varchar(200)"/>
            <column name="medical_notes" type="text"/>
            <column name="parent_full_name" type="varchar(200)"/>
            <column name="parent_phone" type="varchar(20)"/>
            <column name="parent_email" type="varchar(200)"/>
            <column name="consent_personal_data" type="boolean" defaultValueBoolean="false"/>
            <column name="consent_photo_video" type="boolean" defaultValueBoolean="false"/>
            <column name="consent_date" type="timestamp"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>
    </changeSet>

    <!-- ═══ Обновление users — каждая колонка отдельно ═══ -->
    <changeSet id="007-04a-users-birth-date" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="users" columnName="birth_date"/></not>
        </preConditions>
        <addColumn tableName="users">
            <column name="birth_date" type="date"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-04b-users-phone" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="users" columnName="phone"/></not>
        </preConditions>
        <addColumn tableName="users">
            <column name="phone" type="varchar(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-04c-users-email" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="users" columnName="email"/></not>
        </preConditions>
        <addColumn tableName="users">
            <column name="email" type="varchar(200)"/>
        </addColumn>
    </changeSet>

    <!-- ═══ Обновление bookings — каждая колонка отдельно ═══ -->
    <changeSet id="007-05a-bookings-payment-status" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bookings" columnName="payment_status"/></not>
        </preConditions>
        <addColumn tableName="bookings">
            <column name="payment_status" type="varchar(30)" defaultValue="NOT_REQUIRED"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-05b-bookings-amount-due" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bookings" columnName="amount_due"/></not>
        </preConditions>
        <addColumn tableName="bookings">
            <column name="amount_due" type="decimal(10,2)" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-05c-bookings-amount-paid" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bookings" columnName="amount_paid"/></not>
        </preConditions>
        <addColumn tableName="bookings">
            <column name="amount_paid" type="decimal(10,2)" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-05d-bookings-payment-deadline" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bookings" columnName="payment_deadline"/></not>
        </preConditions>
        <addColumn tableName="bookings">
            <column name="payment_deadline" type="date"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-05e-bookings-payment-date" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bookings" columnName="payment_date"/></not>
        </preConditions>
        <addColumn tableName="bookings">
            <column name="payment_date" type="timestamp"/>
        </addColumn>
    </changeSet>

    <changeSet id="007-05f-bookings-notes" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="bookings" columnName="notes"/></not>
        </preConditions>
        <addColumn tableName="bookings">
            <column name="notes" type="text"/>
        </addColumn>
    </changeSet>

    <!-- ═══ Уведомления ═══ -->
    <changeSet id="007-06-notifications" author="dev">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="notifications"/></not>
        </preConditions>
        <createTable tableName="notifications">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_notification_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="booking_id" type="bigint">
                <constraints foreignKeyName="fk_notification_booking"
                             referencedTableName="bookings"
                             referencedColumnNames="id"/>
            </column>
            <column name="event_id" type="bigint">
                <constraints foreignKeyName="fk_notification_event"
                             referencedTableName="events"
                             referencedColumnNames="id"/>
            </column>
            <column name="type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="sent" type="boolean" defaultValueBoolean="false"/>
            <column name="sent_at" type="timestamp"/>
            <column name="scheduled_at" type="timestamp"/>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
        </createTable>

        <createIndex tableName="notifications" indexName="idx_notifications_user_sent">
            <column name="user_id"/>
            <column name="sent"/>
        </createIndex>

        <createIndex tableName="notifications" indexName="idx_notifications_scheduled">
            <column name="scheduled_at"/>
            <column name="sent"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>