<?xml version="1.0" encoding="UTF-8"?>
<!--
    Начальная схема БД Soldo (single-tenant, self-deploy).
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════
         НАСТРОЙКИ ПРИЛОЖЕНИЯ
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-001-app-config" author="savvy">
        <createTable tableName="app_config">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)" defaultValue="Моя организация">
                <constraints nullable="false"/>
            </column>
            <column name="domain" type="VARCHAR(255)"/>
            <column name="event_label" type="VARCHAR(100)" defaultValue="Событие">
                <constraints nullable="false"/>
            </column>
            <column name="participant_label" type="VARCHAR(100)" defaultValue="Участник">
                <constraints nullable="false"/>
            </column>
            <column name="booking_label" type="VARCHAR(100)" defaultValue="Бронирование">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert tableName="app_config">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="Моя организация"/>
            <column name="event_label" value="Событие"/>
            <column name="participant_label" value="Участник"/>
            <column name="booking_label" value="Бронирование"/>
        </insert>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         ПОЛЬЗОВАТЕЛИ
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-010-users" author="savvy">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(255)"/>
            <column name="password_hash" type="VARCHAR(255)"/>
            <column name="role" type="VARCHAR(50)"/>
            <column name="birth_date" type="DATE"/>
            <column name="phone" type="VARCHAR(50)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="init-012-participant-profiles" author="savvy">
        <createTable tableName="participant_profiles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_participant_profiles_user"
                             foreignKeyName="fk_participant_profiles_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="birth_date" type="DATE"/>
            <column name="medical_notes" type="TEXT"/>
            <column name="parent_full_name" type="VARCHAR(255)"/>
            <column name="parent_phone" type="VARCHAR(50)"/>
            <column name="parent_email" type="VARCHAR(255)"/>
            <column name="parent_birth_date" type="DATE"/>
            <column name="parent_passport_series" type="VARCHAR(10)"/>
            <column name="parent_passport_number" type="VARCHAR(20)"/>
            <column name="parent_passport_issued_by" type="TEXT"/>
            <column name="parent_passport_issued_date" type="DATE"/>
            <column name="registration_address" type="TEXT"/>
            <column name="child_document_type" type="VARCHAR(50)"/>
            <column name="child_document_series" type="VARCHAR(10)"/>
            <column name="child_document_number" type="VARCHAR(20)"/>
            <column name="consent_personal_data" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="consent_photo_video" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="consent_date" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         СОБЫТИЯ
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-020-event-categories" author="savvy">
        <createTable tableName="event_categories">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_event_categories_name"/>
            </column>
            <column name="format" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="icon_url" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="init-021-events" author="savvy">
        <createTable tableName="events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="category_id" type="BIGINT">
                <constraints foreignKeyName="fk_events_category"
                             referencedTableName="event_categories"
                             referencedColumnNames="id"/>
            </column>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="max_participants" type="INTEGER"/>
            <column name="game_master" type="VARCHAR(255)"/>
            <column name="price" type="DECIMAL(10,2)" defaultValueNumeric="0"/>
            <column name="price_with_certificate" type="DECIMAL(10,2)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="PUBLISHED"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="events" indexName="idx_events_category_id">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="init-022-event-bookings-summary" author="savvy">
        <createTable tableName="event_bookings_summary">
            <column name="event_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_summary_event"
                             referencedTableName="events"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="total_bookings" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="confirmed_bookings" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="pending_bookings" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="cancelled_bookings" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="num_of_participants" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         БРОНИРОВАНИЯ
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-030-bookings" author="savvy">
        <createTable tableName="bookings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_bookings_event"
                             referencedTableName="events"
                             referencedColumnNames="id"/>
            </column>
            <column name="guest_name" type="VARCHAR(255)"/>
            <column name="guest_phone" type="VARCHAR(50)"/>
            <column name="guest_email" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="VARCHAR(50)" defaultValue="NOT_REQUIRED"/>
            <column name="amount_due" type="DECIMAL(10,2)" defaultValueNumeric="0"/>
            <column name="amount_paid" type="DECIMAL(10,2)" defaultValueNumeric="0"/>
            <column name="payment_deadline" type="DATE"/>
            <column name="payment_date" type="TIMESTAMP"/>
            <column name="notes" type="TEXT"/>
            <column name="has_certificate" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="bookings" indexName="idx_bookings_event_id">
            <column name="event_id"/>
        </createIndex>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         ДОКУМЕНТЫ
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-040-document-templates" author="savvy">
        <createTable tableName="document_templates">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="file_url" type="VARCHAR(500)"/>
            <column name="category_format" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="is_required" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="requires_signature" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="init-041-booking-documents" author="savvy">
        <createTable tableName="booking_documents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_booking_documents_booking"
                             referencedTableName="bookings"
                             referencedColumnNames="id"/>
            </column>
            <column name="document_template_id" type="BIGINT">
                <constraints foreignKeyName="fk_booking_documents_template"
                             referencedTableName="document_templates"
                             referencedColumnNames="id"/>
            </column>
            <column name="delivered" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="delivered_at" type="TIMESTAMP"/>
            <column name="signer_name" type="VARCHAR(255)"/>
            <column name="signed_at" type="TIMESTAMP"/>
            <column name="signer_ip" type="VARCHAR(64)"/>
            <column name="filled_data" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="booking_documents" indexName="idx_booking_documents_booking_id">
            <column name="booking_id"/>
        </createIndex>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         УВЕДОМЛЕНИЯ И ЗАПРОСЫ
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-050-notifications" author="savvy">
        <createTable tableName="notifications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_notifications_user"
                             referencedTableName="users"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints foreignKeyName="fk_notifications_booking"
                             referencedTableName="bookings"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints foreignKeyName="fk_notifications_event"
                             referencedTableName="events"
                             referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="sent" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="sent_at" type="TIMESTAMP"/>
            <column name="scheduled_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="init-051-inquiries" author="savvy">
        <createTable tableName="inquiries">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(50)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="event_title" type="VARCHAR(255)"/>
            <column name="message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         НАСТРОЙКИ ПЛАНИРОВЩИКА И ВИДЖЕТА
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-060-scheduler-settings" author="savvy">
        <createTable tableName="scheduler_settings">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_reminder_cron" type="VARCHAR(50)" defaultValue="0 0 10 * * *">
                <constraints nullable="false"/>
            </column>
            <column name="payment_reminder_cron" type="VARCHAR(50)" defaultValue="0 0 9 * * *">
                <constraints nullable="false"/>
            </column>
            <column name="event_reminder_days_before" type="INTEGER" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="payment_reminder_days_before" type="INTEGER" defaultValueNumeric="3">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <insert tableName="scheduler_settings">
            <column name="id" valueNumeric="1"/>
            <column name="event_reminder_cron" value="0 0 10 * * *"/>
            <column name="payment_reminder_cron" value="0 0 9 * * *"/>
            <column name="event_reminder_days_before" valueNumeric="1"/>
            <column name="payment_reminder_days_before" valueNumeric="3"/>
        </insert>
    </changeSet>

    <changeSet id="init-061-widget-config" author="savvy">
        <createTable tableName="widget_config">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="primary_color" type="VARCHAR(20)" defaultValue="#2563eb"/>
            <column name="background_color" type="VARCHAR(20)" defaultValue="#ffffff"/>
            <column name="text_color" type="VARCHAR(20)" defaultValue="#111827"/>
            <column name="button_text_color" type="VARCHAR(20)" defaultValue="#ffffff"/>
            <column name="border_radius" type="VARCHAR(20)" defaultValue="8px"/>
            <column name="font_family" type="VARCHAR(100)" defaultValue="inherit"/>
            <column name="show_category_step" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="success_message" type="TEXT"
                    defaultValue="Бронирование успешно создано! Мы свяжемся с вами."/>
            <column name="custom_css" type="TEXT"/>
            <column name="category_step_title" type="VARCHAR(255)" defaultValue="Выберите направление"/>
            <column name="button_label" type="VARCHAR(100)" defaultValue="Записаться"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <insert tableName="widget_config">
            <column name="id" valueNumeric="1"/>
        </insert>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         КОНТЕНТ САЙТА
         ═══════════════════════════════════════════════════════════════════ -->

    <changeSet id="init-070-site-settings" author="savvy">
        <createTable tableName="site_settings">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="setting_key" type="VARCHAR(200)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_site_settings_key"/>
            </column>
            <column name="setting_value" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="init-071-team-members" author="savvy">
        <createTable tableName="team_members">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="initials" type="VARCHAR(10)"/>
            <column name="bio" type="TEXT"/>
            <column name="quote" type="TEXT"/>
            <column name="photo_url" type="VARCHAR(500)"/>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="init-072-gallery-items" author="savvy">
        <createTable tableName="gallery_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="image_url" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="caption" type="VARCHAR(300)"/>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
